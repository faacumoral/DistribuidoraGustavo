@page "/products"

@using DistribuidoraGustavo.App.Utils
@inherits ProductsBase

<div class="simple-ui">

    <Alerts @ref="Alert" Seconds="8"></Alerts>

    <div class="page-header">
        <h1>Productos</h1>
        <div class="search-row">
            <SearchInput Disabled="@State.Processing"
                         OnSearch="SearchProducts"
                         OnValueChanged="(string newValue) => State.Filter = newValue"
                         SearchValue="@State.Filter"
                         Placeholder="Turrón, mogul, 4003"
                         @ref="SearchInput"></SearchInput>
            <button class="btn btn-outline-dark" disabled="@State.Processing" @onclick="SearchProducts">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
        <button class="btn btn-success" @onclick="AddProduct">
            <i class="bi bi-plus-lg"></i> Agregar producto
        </button>
    </div>

    <Spinner Show="@State.Processing"></Spinner>

    @if (!State.Processing)
    {
        @if (Products.Count == 0)
        {
            <p>No hay productos con ese nombre o código.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Familia</th>
                        <th class="num">Bulto</th>
                        <th class="num">Precio base</th>
                        @foreach (var priceList in PriceLists)
                        {
                            <th class="num">@priceList.Name</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Products)
                    {
                        <tr class="clickable" title="Editar @product.Name" @onclick="() => UpdateProduct(product)">
                            <td>@product.Code</td>
                            <td class="strong">@product.Name</td>
                            <td>@(string.IsNullOrEmpty(product.FamilyName) ? "-" : product.FamilyName)</td>
                            <td class="num">@(product.QuantityPerBox > 0 ? product.QuantityPerBox.ToString() : "-")</td>
                            <td class="num strong">@product.BasePrice.ToMoney()</td>
                            @foreach (var priceList in PriceLists)
                            {
                                <td class="num">@PriceIn(product, priceList)</td>
                            }
                            <td class="actions">
                                <button class="btn btn-dark">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

</div>
