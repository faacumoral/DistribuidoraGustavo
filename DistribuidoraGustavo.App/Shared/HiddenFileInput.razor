@using System.Net.Http.Headers;

<InputFile OnChange="HandleSelected" accept=".xls,.xlsx"
    id="txtInputFile" style="display: none;" />


@code {
    private const long MAX_FILE_SIZE = 20 * 1024 * 1024;

    [Parameter]
    public EventCallback<MultipartFormDataContent> OnChange { get; set; }
    [Inject]
    public IJSRuntime jsRuntime { get; set; }

    private async Task HandleSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        var ms = new MemoryStream();
        await using (var fileStream = file.OpenReadStream(MAX_FILE_SIZE))
        {
            await fileStream.CopyToAsync(ms);
        }
        ms.Position = 0;

        var content = new MultipartFormDataContent();
        content.Headers.ContentDisposition = new ContentDispositionHeaderValue("form-data");
        content.Add(new StreamContent(ms, Convert.ToInt32(ms.Length)), "file", file.Name);
        await OnChange.InvokeAsync(content);
    }

    public async Task Open()
    {
        await jsRuntime.InvokeVoidAsync("ClickElement", "txtInputFile");
    }
}
